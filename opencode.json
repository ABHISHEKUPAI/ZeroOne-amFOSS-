{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openai": {
      "options": {
        "apiKey": "{env:OPENAI_API_KEY}"
      }
    }
  },
  "mcp": {
    "silicon": {
      "type": "local",
      "command": [
        "node",
        "dist/index.js"
      ],
      "enabled": true,
      "environment": {
        "NITROSTACK_APP_MODE": "universal",
        "NITRO_LOG_LEVEL": "warn"
      },
      "timeout": 120000
    }
  }
}
